rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['superadmin', 'super_admin'];
    }

    match /heroImages/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /serviceIcons/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /blogImages/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /partners/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /enterpriseFeatures/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /clientTestimonials/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /downloads/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /galleryImages/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /leadershipImages/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /aboutImages/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /profileImages/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /admissionDocuments/{applicationId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /applications/{applicationId}/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if request.resource.size <= 5 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
