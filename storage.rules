rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    match /heroImages/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /serviceIcons/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogImages/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enterpriseFeatures/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clientTestimonials/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /downloads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galleryImages/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leadershipImages/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /aboutImages/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /profileImages/{uid}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.auth.uid == uid;
    }

    match /admissionDocuments/{applicationId}/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /applications/{applicationId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
