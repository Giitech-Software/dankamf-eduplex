rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
  
    // Helper function to check for admin/superadmin role from Firestore
    function isAdmin() {
      // This checks the 'users' collection in Firestore for the user's role.
      return request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // Allow public read access to all files, but restrict writes to admins.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin(); // Only admins can upload, update, or delete files.
    }
  }
}
