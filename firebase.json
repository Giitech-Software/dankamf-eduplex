{
    "firestore":  {
                      "rules":  "firestore.rules"
                  },
    "storage":  {
                    "rules":  "storage.rules"
                },
    "hosting":  {
                    "site": "dankamf-eduplex",
                    "public":  "build",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ]
                }
}
